# Rahsia Edge Functions. Salin ke `supabase/functions/.env`, isi, kemudian: npm run secrets:set
# (atau Dashboard > Edge Functions > Secrets). JANGAN commit `.env`.
# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY disediakan secara automatik oleh Supabase.
GEMINI_API_KEY=
KATA_LALUAN_PANITIA=
# Pilihan:
# GEMINI_MODEL=gemini-3.5-flash
# HAD_JANA_SEJAM=60
